{
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "/bin/sh -c 'PATH=\"$PATH:$HOME/.local/bin:$HOME/.cargo/bin\"; command -v uvx >/dev/null 2>&1 || { echo \"agentprint: uvx not found, so this command was not checked (install uv to turn it on)\" >&2; printf '\"'\"'%s\\n'\"'\"' '\"'\"'{\"permission\": \"allow\"}'\"'\"'; exit 0; }; out=$(uvx --from agentprint==0.1.1 agentprint guard --agent cursor); s=$?; case \"$s\" in 0) [ -n \"$out\" ] && printf \"%s\\n\" \"$out\"; exit 0 ;; 3) [ -n \"$out\" ] && printf \"%s\\n\" \"$out\"; exit 2 ;; esac; echo \"agentprint: hook check failed (exit $s); the command was allowed\" >&2; printf '\"'\"'%s\\n'\"'\"' '\"'\"'{\"permission\": \"allow\"}'\"'\"'; exit 0' agentprint-plugin",
        "timeout": 60,
        "matcher": "(?:(?:^|[;&|({!`\\n]|\\$\\(|\\b(?:do|then|else|elif|if|while|until|xargs|sudo|doas|env|exec|eval|nohup|nice|ionice|chronic|unbuffer|watch|flock|setsid|time|command|builtin|caffeinate|stdbuf|npx|pnpx|bunx|uvx|corepack)\\s|\\bg?timeout\\s+\\S+\\s|\\bpython[0-9.]*\\s+-m\\s)\\s*(?:-\\S+\\s+(?:[^-\\s;&|]\\S*\\s+)?)*(?:\\w+=\\S*\\s+)*(?:\\S*/)?(?:(?:npm|pnpm|yarn|bun)\\b[^;&|\\n]*?\\b(?:publish|release|deploy|ship)\\b|npm\\b[^;&|\\n]*?\\bpu(?:b(?:l(?:is?)?)?)?\\b|(?:uv|poetry|hatch|flit)\\b[^;&|\\n]*?\\bpublish\\b|twine\\b[^;&|\\n]*?\\bupload\\b|(?:changeset|lerna)\\b[^;&|\\n]*?\\bpublish\\b|(?:np|semantic-release|release-it)(?:\\s|$)|git(?:\\s+-\\S+(?:\\s+[^-\\s]\\S*)?)*\\s+push\\b|(?:npm|pnpm|yarn|bun|uv|poetry|hatch|flit|twine|git|changeset|lerna)(?:\\s+-\\S+(?:\\s+[^-\\s]\\S*)?)*\\s+[\\\"']?\\$)|(?:^|[;&|({!`\\n]|\\$\\(|\\b(?:do|then|else|elif|if|while|until|xargs|sudo|doas|env|exec|eval|nohup|nice|ionice|chronic|unbuffer|watch|flock|setsid|time|command|builtin|caffeinate|stdbuf|npx|pnpx|bunx|uvx|corepack)\\s|\\bg?timeout\\s+\\S+\\s|\\bpython[0-9.]*\\s+-m\\s)\\s*(?:-\\S+\\s+(?:[^-\\s;&|]\\S*\\s+)?)*(?:\\w+=\\S*\\s+)*(?:(?:g?make|just|go-task|task)(?:\\s|$)|(?:npm|pnpm|yarn|bun)(?:\\s+-\\S+(?:\\s+[^-\\s]\\S*)?)*\\s+version\\b|\\S*/\\S|(?:sh|bash|zsh|dash|ksh|fish|ash|mksh|tcsh|csh|python[0-9.]*|pypy[0-9.]*|node|nodejs|tsx|ts-node|bun|ruby|perl|php)(?:\\s+-\\S+)*(?:\\s+[^-\\s]|\\s+-(?:\\s|$)|\\s*$|\\s*[;&|)])|deno\\s+(?:run|eval)\\b|(?:source|\\.)\\s+\\S|(?:uv|poetry|pdm|pipenv|hatch|rye)\\s+run\\s+\\S|eval\\b|alias\\s|set\\s+--|printf\\s+-v\\s|xargs\\b|env\\s+-S|[\\\"']?\\$[\\w{(@*'\\\"]|`|[^\\s;&|()<>]*[\\\"'\\\\\\\\])|(?:<<|\\b[A-Za-z_]\\w*=(?:'[^']*|\\\"[^\\\"]*|\\S*)\\b(?:publish|push|upload)\\b))"
      }
    ]
  }
}
